<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Fairmont Bank — Administration</title>

    <style>
        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            min-height: 100%;
            font-family: Arial, Helvetica, sans-serif;
            background: #071426;
            color: #ffffff;
        }

        body {
            min-height: 100vh;
        }

        .admin-shell {
            min-height: 100vh;
            display: flex;
        }

        /* SIDEBAR */

        .sidebar {
            width: 250px;
            min-height: 100vh;
            background: #08182b;
            border-right: 1px solid rgba(184, 149, 74, 0.18);
            padding: 26px 18px;
            position: fixed;
            left: 0;
            top: 0;
            bottom: 0;
        }

        .brand {
            padding: 6px 10px 28px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.07);
            margin-bottom: 24px;
        }

        .brand img {
            display: block;
            width: 190px;
            max-width: 100%;
            height: auto;
        }

        .admin-badge {
            margin-top: 15px;
            color: #d8b96a;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1.7px;
            text-transform: uppercase;
        }

        .nav-title {
            padding: 0 10px;
            margin-bottom: 10px;
            color: #667d97;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
        }

        .nav-link {
            display: flex;
            align-items: center;
            gap: 12px;
            width: 100%;
            padding: 12px 12px;
            margin-bottom: 5px;
            border-radius: 9px;
            color: #aabbd0;
            text-decoration: none;
            font-size: 13px;
            transition: background 0.2s, color 0.2s;
        }

        .nav-link:hover,
        .nav-link.active {
            background: rgba(184, 149, 74, 0.10);
            color: #d8b96a;
        }

        .nav-icon {
            width: 22px;
            text-align: center;
            font-size: 14px;
        }

        .sidebar-bottom {
            position: absolute;
            left: 18px;
            right: 18px;
            bottom: 22px;
        }

        .admin-user {
            padding: 13px;
            border-radius: 10px;
            background: rgba(255, 255, 255, 0.035);
            border: 1px solid rgba(255, 255, 255, 0.06);
            margin-bottom: 10px;
        }

        .admin-user-label {
            color: #687f98;
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 5px;
        }

        .admin-user-name {
            color: #dce6f2;
            font-size: 13px;
            font-weight: 700;
        }

        .logout {
            display: block;
            width: 100%;
            padding: 11px;
            text-align: center;
            border-radius: 9px;
            border: 1px solid rgba(220, 100, 100, 0.22);
            color: #d99a9a;
            text-decoration: none;
            font-size: 12px;
        }

        .logout:hover {
            background: rgba(220, 100, 100, 0.08);
        }

        /* MAIN */

        .main {
            margin-left: 250px;
            width: calc(100% - 250px);
            min-height: 100vh;
            padding: 34px;
            background:
                radial-gradient(circle at top right, rgba(184, 149, 74, 0.07), transparent 32%),
                #071426;
        }

        .topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            margin-bottom: 30px;
        }

        .page-title {
            margin: 0;
            font-size: 26px;
            font-weight: 700;
        }

        .page-subtitle {
            margin: 7px 0 0;
            color: #8195ad;
            font-size: 13px;
        }

        .secure-status {
            display: flex;
            align-items: center;
            gap: 8px;
            color: #91b79e;
            font-size: 12px;
            white-space: nowrap;
        }

        .status-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #6eae82;
        }

        /* CARDS */

        .stats {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 16px;
            margin-bottom: 24px;
        }

        .stat-card {
            background: rgba(12, 31, 53, 0.82);
            border: 1px solid rgba(255, 255, 255, 0.065);
            border-radius: 14px;
            padding: 20px;
        }

        .stat-label {
            color: #7890a9;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            margin-bottom: 10px;
        }

        .stat-value {
            color: #ffffff;
            font-size: 25px;
            font-weight: 700;
        }

        .content-grid {
            display: grid;
            grid-template-columns: 1.6fr 1fr;
            gap: 20px;
        }

        .panel {
            background: rgba(12, 31, 53, 0.82);
            border: 1px solid rgba(255, 255, 255, 0.065);
            border-radius: 14px;
            padding: 22px;
        }

        .panel-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 18px;
        }

        .panel-title {
            margin: 0;
            font-size: 16px;
            font-weight: 700;
        }

        .panel-description {
            margin: 5px 0 0;
            color: #7890a9;
            font-size: 12px;
            line-height: 1.5;
        }

        .chat-button {
            display: inline-block;
            padding: 9px 13px;
            border-radius: 8px;
            background: rgba(184, 149, 74, 0.12);
            border: 1px solid rgba(184, 149, 74, 0.25);
            color: #d8b96a;
            text-decoration: none;
            font-size: 12px;
            font-weight: 700;
        }

        .chat-button:hover {
            background: rgba(184, 149, 74, 0.18);
        }

        .quick-actions {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
        }

        .action {
            display: block;
            padding: 15px;
            border-radius: 10px;
            background: rgba(255, 255, 255, 0.035);
            border: 1px solid rgba(255, 255, 255, 0.055);
            color: #dce6f2;
            text-decoration: none;
            transition: background 0.2s, border-color 0.2s;
        }

        .action:hover {
            background: rgba(255, 255, 255, 0.055);
            border-color: rgba(184, 149, 74, 0.22);
        }

        .action-title {
            font-size: 13px;
            font-weight: 700;
            margin-bottom: 5px;
        }

        .action-text {
            color: #71869e;
            font-size: 11px;
            line-height: 1.4;
        }

        .security-list {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .security-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 0;
            border-bottom: 1px solid rgba(255, 255, 255, 0.055);
        }

        .security-row:last-child {
            border-bottom: 0;
        }

        .security-name {
            color: #cbd7e5;
            font-size: 12px;
        }

        .security-value {
            color: #8fa4ba;
            font-size: 11px;
        }

        .active-status {
            color: #8fc29f;
        }

        /* MOBILE */

        @media (max-width: 1000px) {
            .stats {
                grid-template-columns: repeat(2, 1fr);
            }

            .content-grid {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 720px) {
            .sidebar {
                position: relative;
                width: 100%;
                min-height: auto;
                padding: 20px;
            }

            .sidebar-bottom {
                position: static;
                margin-top: 20px;
            }

            .main {
                margin-left: 0;
                width: 100%;
                padding: 22px 16px;
            }

            .admin-shell {
                display: block;
            }

            .topbar {
                align-items: flex-start;
                flex-direction: column;
            }

            .stats {
                grid-template-columns: 1fr 1fr;
            }
        }

        @media (max-width: 480px) {
            .stats {
                grid-template-columns: 1fr;
            }

            .quick-actions {
                grid-template-columns: 1fr;
            }

            .page-title {
                font-size: 22px;
            }
        }
    </style>
</head>

<body>

<div class="admin-shell">

    <aside class="sidebar">

        <div class="brand">
            <img
                src="{{ url_for('static', filename='images/fairmont-bank-logo.png') }}"
                alt="Fairmont Bank">

            <div class="admin-badge">
                Administration Portal
            </div>
        </div>

        <div class="nav-title">Administration</div>

        <a href="{{ url_for('admin_dashboard') }}"
           class="nav-link active">
            <span class="nav-icon">▦</span>
            Dashboard
        </a>

        <a href="/admin/live-chat" class="nav-link">
            <span class="nav-icon">?</span>
            Live Chat
        </a>
<a href="/admin/bank-email" class="admin-nav-link">
    <span class="admin-nav-icon">✉</span>
    <span>Customer Messages</span>
</a>


        <a href="#" class="nav-link">
            <span class="nav-icon">◎</span>
            Customers
        </a>

        <a href="#" class="nav-link">
            <span class="nav-icon">▤</span>
            Transactions
        </a>

        <a href="#" class="nav-link">
            <span class="nav-icon">◈</span>
            Accounts
        </a>

        <div class="sidebar-bottom">

            <div class="admin-user">
                <div class="admin-user-label">
                    Signed in as
                </div>

                <div class="admin-user-name">
                    {{ admin.username }}
                </div>
            </div>

            <a href="{{ url_for('admin_logout') }}"
               class="logout">
                Sign Out
            </a>

        </div>

    </aside>


    <main class="main">

        <div class="topbar">

            <div>
                <h1 class="page-title">
                    Administration Dashboard
                </h1>

                <p class="page-subtitle">
                    Fairmont Bank administrative control center.
                </p>
            </div>

            <div class="secure-status">
                <span class="status-dot"></span>
                Secure administrator session
            </div>

        </div>


        <section class="stats">

            <div class="stat-card">
                <div class="stat-label">
                    Administrator
                </div>

                <div class="stat-value">
                    {{ admin.username }}
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-label">
                    Account Status
                </div>

                <div class="stat-value">
                    Active
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-label">
                    Support
                </div>

                <div class="stat-value">
                    Live Chat
                </div>
            </div>

            <div class="stat-card">
                <div class="stat-label">
                    Security
                </div>

                <div class="stat-value">
                    Protected
                </div>
            </div>

        </section>


        <section class="content-grid">

            <div class="panel">

                <div class="panel-header">

                    <div>
                        <h2 class="panel-title">
                            Administration Tools
                        </h2>

                        <p class="panel-description">
                            Access the administrative functions available
                            to authorized Fairmont Bank personnel.
                        </p>
                    </div>

                </div>

                <div class="quick-actions">

                    <a href="/admin/live-chat" class="action">
                        <div class="action-title">
                            Live Chat
                        </div>

                        <div class="action-text">
                            View customer conversations and respond
                            to support messages.
                        </div>
                    </a>

                    <a href="#" class="action">
                        <div class="action-title">
                            Customer Management
                        </div>

                        <div class="action-text">
                            Customer administration tools will be
                            available here.
                        </div>
                    </a>

                    <a href="#" class="action">
                        <div class="action-title">
                            Transaction Management
                        </div>

                        <div class="action-text">
                            Review banking transaction activity.
                        </div>
                    </a>

                    <a href="#" class="action">
                        <div class="action-title">
                            Account Management
                        </div>

                        <div class="action-text">
                            Manage authorized account information.
                        </div>
                    </a>

                </div>

            </div>


            <div class="panel">

                <div class="panel-header">

                    <div>
                        <h2 class="panel-title">
                            Security
                        </h2>

                        <p class="panel-description">
                            Current administrator session status.
                        </p>
                    </div>

                </div>

                <div class="security-list">

                    <div class="security-row">
                        <span class="security-name">
                            Administrator
                        </span>

                        <span class="security-value">
                            {{ admin.username }}
                        </span>
                    </div>

                    <div class="security-row">
                        <span class="security-name">
                            Account
                        </span>

                        <span class="security-value active-status">
                            Active
                        </span>
                    </div>

                    <div class="security-row">
                        <span class="security-name">
                            Authentication
                        </span>

                        <span class="security-value">
                            Password Protected
                        </span>
                    </div>

                    <div class="security-row">
                        <span class="security-name">
                            Session
                        </span>

                        <span class="security-value active-status">
                            Active
                        </span>
                    </div>

                </div>

            </div>

        </section>

    </main>

</div>

</body>
</html>