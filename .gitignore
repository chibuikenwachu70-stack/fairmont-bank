# app.py backup/snapshot files
app.py.*
app_*.py
app_backup_*
app_before_*
app_BEFORE_*

# Other backup naming patterns
*_backup.py
*_backup/
*backup*.py
*backup*.html
*backup*.bak

# BEFORE snapshots
*BEFORE*.py
*BEFORE*.html
*BEFORE*.bak
*before_*.py
*before_*.html
*before_*.bak

# Timestamped snapshot files
*.before_*.py
*.before_*.html
*.before_*.bak

