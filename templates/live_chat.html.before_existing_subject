<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Live Chat | Fairmont Bank</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: Arial, Helvetica, sans-serif;
            background: #06152d;
            color: #ffffff;
        }

        .chat-page {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .chat-header {
            padding: 18px 22px;
            background: rgba(8, 28, 56, 0.96);
            border-bottom: 1px solid rgba(255,255,255,0.08);
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .back-button {
            text-decoration: none;
            color: #ffffff;
            font-size: 24px;
            line-height: 1;
        }

        .chat-brand {
            display: flex;
            align-items: center;
        }

        .chat-logo {
            width: 150px;
            height: auto;
            display: block;
        }

        .chat-header-title {
            margin-left: auto;
            text-align: right;
        }

        .chat-header-title strong {
            display: block;
            font-size: 15px;
        }

        .chat-header-title span {
            display: block;
            margin-top: 3px;
            font-size: 12px;
            color: #9fb3cc;
        }

        .chat-container {
            width: 100%;
            max-width: 900px;
            margin: 0 auto;
            padding: 24px 16px;
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        .support-card {
            background: rgba(15, 38, 70, 0.88);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 18px;
            padding: 20px;
            margin-bottom: 16px;
        }

        .support-card h1 {
            margin: 0 0 7px;
            font-size: 22px;
        }

        .support-card p {
            margin: 0;
            color: #aebed2;
            font-size: 14px;
            line-height: 1.5;
        }

        .conversation {
            flex: 1;
            min-height: 420px;
            max-height: 58vh;
            overflow-y: auto;
            padding: 18px;
            background: rgba(7, 25, 49, 0.9);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 18px;
        }

        .empty-chat {
            height: 100%;
            min-height: 300px;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            color: #91a5bf;
            padding: 30px;
        }

        .message {
            display: flex;
            margin-bottom: 14px;
        }

        .message.customer {
            justify-content: flex-end;
        }

        .message-bubble {
            max-width: 78%;
            padding: 12px 15px;
            border-radius: 16px;
            background: #17385f;
        }

        .message.customer .message-bubble {
            background: #b8954a;
            color: #07162d;
            border-bottom-right-radius: 5px;
        }

        .message.support .message-bubble {
            border-bottom-left-radius: 5px;
        }

        .message-label {
            font-size: 11px;
            font-weight: 700;
            margin-bottom: 5px;
            opacity: 0.75;
        }

        .message-text {
            font-size: 14px;
            line-height: 1.5;
            white-space: pre-wrap;
            word-break: break-word;
        }

        .message-time {
            margin-top: 5px;
            font-size: 10px;
            opacity: 0.65;
        }

        .message-success {
            width: 100%;
            margin: 0 0 12px 0;
            padding: 12px 14px;
            display: flex;
            align-items: center;
            gap: 9px;
            border: 1px solid rgba(74, 180, 125, 0.28);
            border-radius: 10px;
            background: rgba(74, 180, 125, 0.08);
            color: #b9e7ce;
            font-size: 12px;
            line-height: 1.45;
        }

        .success-icon {
            width: 20px;
            height: 20px;
            flex: 0 0 20px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: rgba(74, 180, 125, 0.18);
            color: #8ed2aa;
            font-size: 12px;
            font-weight: 700;
        }

        .subject-field {
            width: 100%;
            margin-bottom: 12px;
        }

        .subject-field label {
            display: block;
            margin-bottom: 7px;
            color: #c5d2df;
            font-size: 12px;
            font-weight: 700;
        }

        .chat-subject-input {
            width: 100%;
            padding: 12px 13px;
            border: 1px solid rgba(159, 179, 204, 0.18);
            border-radius: 10px;
            background: rgba(255, 255, 255, 0.045);
            color: #ffffff;
            outline: none;
            font-family: inherit;
            font-size: 13px;
        }

        .chat-subject-input::placeholder {
            color: #637991;
        }

        .chat-subject-input:focus {
            border-color: rgba(184, 149, 74, 0.65);
            background: rgba(255, 255, 255, 0.06);
        }

        .subject-help {
            margin-top: 6px;
            color: #5f758d;
            font-size: 9px;
        }

        .subject-error {
            width: 100%;
            margin-bottom: 12px;
            padding: 11px 13px;
            border: 1px solid rgba(190, 82, 82, 0.30);
            border-radius: 10px;
            background: rgba(190, 82, 82, 0.08);
            color: #e4a8a8;
            font-size: 11px;
        }

        .chat-form {
            margin-top: 15px;
            display: flex;
            gap: 10px;
            padding: 12px;
            background: rgba(15, 38, 70, 0.88);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 16px;
        }

        .chat-input {
            flex: 1;
            min-width: 0;
            border: none;
            outline: none;
            resize: none;
            min-height: 48px;
            max-height: 130px;
            padding: 14px;
            border-radius: 12px;
            background: #071a35;
            color: #ffffff;
            font-family: inherit;
            font-size: 14px;
        }

        .chat-input::placeholder {
            color: #7188a5;
        }

        .send-button {
            align-self: stretch;
            min-width: 90px;
            border: none;
            border-radius: 12px;
            background: #b8954a;
            color: #07162d;
            font-weight: 700;
            cursor: pointer;
            padding: 0 18px;
        }

        .send-button:hover {
            opacity: 0.92;
        }

        @media (max-width: 600px) {
            .chat-header {
                padding: 15px;
            }

            .chat-logo {
                width: 125px;
            }

            .chat-header-title {
                display: none;
            }

            .chat-container {
                padding: 16px 12px;
            }

            .conversation {
                min-height: 50vh;
            }

            .message-bubble {
                max-width: 88%;
            }

            .chat-form {
                align-items: stretch;
            }

            .send-button {
                min-width: 72px;
                padding: 0 12px;
            }
        }
    </style>
</head>

<body>

<div class="chat-page">

    <header class="chat-header">

        <a href="{{ url_for('dashboard') }}"
           class="back-button"
           aria-label="Back to dashboard">
            &#8592;
        </a>

        <div class="chat-brand">
            <img
                src="{{ url_for('static', filename='images/fairmont-bank-logo.png') }}"
                alt="Fairmont Bank"
                class="chat-logo">
        </div>

        <div class="chat-header-title">
            <strong>Live Chat</strong>
            <span>Fairmont Bank Support</span>
        </div>

    </header>

    <main class="chat-container">

        <section class="support-card">
            <h1>Live Chat</h1>
            <p>
                Chat securely with Fairmont Bank Support.
                Send us your question and our support team will respond here.
            </p>
        </section>

        <section class="conversation">

            {% if messages %}

                {% for message in messages %}

                    <div class="message
                        {% if message.sender_type == 'customer' %}
                            customer
                        {% else %}
                            support
                        {% endif %}
                    ">

                        <div class="message-bubble">

                            <div class="message-label">
                                {% if message.sender_type == 'customer' %}
                                    You
                                {% else %}
                                    Fairmont Bank Support
                                {% endif %}
                            </div>

                            <div class="message-text">{{ message.message }}</div>

                            <div class="message-time">
                                {{ message.created_at.strftime('%d %b %Y, %H:%M') }}
                            </div>

                        </div>

                    </div>

                {% endfor %}

            {% else %}

                <div class="empty-chat">
                    <div>
                        <strong>No messages yet.</strong>
                        <p>
                            Start a conversation with Fairmont Bank Support below.
                        </p>
                    </div>
                </div>

            {% endif %}

        </section>

        {% if success_message %}
            <div class="message-success">
                <span class="success-icon">✓</span>
                <span>{{ success_message }}</span>
            </div>
        {% endif %}

        <form
            method="POST"
            action="{{ url_for('live_chat') }}"
            class="chat-form"
        >

            {% if subject_error %}
                <div class="subject-error">
                    {{ subject_error }}
                </div>
            {% endif %}

            {% if not conversation %}
                <div class="subject-field">
                    <label for="chat-subject">
                        Subject / Reason for Contact
                    </label>

                    <input
                        type="text"
                        id="chat-subject"
                        name="subject"
                        class="chat-subject-input"
                        maxlength="200"
                        placeholder="What would you like help with?"
                        required
                    >

                    <div class="subject-help">
                        Please briefly tell us what you need help with.
                    </div>
                </div>
            {% endif %}

            <textarea
                name="message"
                class="chat-input"
                placeholder="Type your message..."
                maxlength="2000"
                required
            ></textarea>

            <button type="submit" class="send-button">
                Send
            </button>

        </form>

    </main>

</div>

</body>
</html>